# ─────────────────────────────────────────────────────────────────────────────
# Melodify BACKEND — biến môi trường (copy thành "be/.env" rồi điền giá trị thật)
# be/.env nằm trong .gitignore → không bao giờ bị commit.
# Hướng dẫn chi tiết: docs/02-cai-dat-supabase-va-gemini.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project Settings → Data API → "Project URL"
SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings → API Keys → "Publishable key" (sb_publishable_...) hoặc legacy "anon"
SUPABASE_PUBLISHABLE_KEY=
# Project Settings → API Keys → "Secret key" (sb_secret_...) hoặc legacy "service_role"
# ⚠️ Toàn quyền với project. Chỉ backend được biết key này.
SUPABASE_SECRET_KEY=
# Chỉ điền nếu project dùng "Legacy JWT secret" (Project Settings → JWT Keys). Có thể để trống.
SUPABASE_JWT_SECRET=
# Nút "Connect" (đầu trang dashboard) → "Session pooler" → copy URI, thay [YOUR-PASSWORD]
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
# Địa chỉ của fe (để cấu hình CORS và redirect sau khi đăng nhập)
WEB_ORIGIN=http://localhost:5173
APP_NAME=Melodify

# Đăng nhập bằng mạng xã hội: để TRỐNG = dùng mọi nhà cung cấp đã bật trong Supabase (Authentication → Providers).
# Chỉ điền khi muốn giới hạn, ví dụ: google,facebook
OAUTH_PROVIDERS=

# ── AI: Google Gemini (https://aistudio.google.com/apikey) ───────────────────
# Để trống vẫn chạy: AI Playlist sẽ dùng bộ phân tích từ khoá thay thế.
GEMINI_API_KEY=
# Model chính (nhanh, ~1–2 giây) và model dự phòng khi model chính quá tải (lỗi 503). Thường không cần sửa.
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL=gemini-flash-latest

# ── Nguồn nhạc ──────────────────────────────────────────────────────────────
AUDIUS_APP_NAME=melodify_learning
