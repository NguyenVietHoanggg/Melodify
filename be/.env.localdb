# Local testing with PGlite (no Supabase needed). Used via: ENV_FILE=.env.localdb
# Points at the Storage emulator started by `npm run db:local` (src/scripts/local-storage.ts)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=local_testing_publishable_key_xxxxxxxx
SUPABASE_SECRET_KEY=local_testing_secret_key_xxxxxxxxxxxxxx
DATABASE_URL=postgresql://postgres@127.0.0.1:54329/postgres
PORT=4000
WEB_ORIGIN=http://localhost:5173
APP_NAME=Melodify
LOCAL_DEV_USER_ID=11111111-1111-4111-8111-111111111111
DB_POOL_MAX=1
