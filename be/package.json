{
  "name": "melodify-be",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Melodify backend: REST API + WebSocket hub + all business logic (player, recommendations, billing, ads, AI).",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup src/index.ts --format esm --platform node --target node22 --sourcemap --clean",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "import:audius": "tsx src/scripts/import-audius.ts",
    "import:podcasts": "tsx src/scripts/import-podcasts.ts",
    "db:check": "tsx src/scripts/check-migrations.ts",
    "db:local": "tsx src/scripts/local-db.ts",
    "dev:local": "tsx watch --clear-screen=false src/index.ts --local-db",
    "local:setup": "npm run db:migrate -- --local-db && npm run import:audius -- --stage=load --local-db && npm run db:seed -- --local-db && npm run import:podcasts -- --stage=load --local-db && tsx src/scripts/local-user.ts --local-db"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "audio-decode": "^3.12.0",
    "compression": "^1.8.2",
    "cookie": "^1.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "fast-xml-parser": "^5.11.2",
    "helmet": "^8.3.0",
    "music-metadata": "^12.1.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "sharp": "^0.35.5",
    "ws": "^8.22.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "pino-pretty": "^13.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
